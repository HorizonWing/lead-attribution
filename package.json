{
  "name": "better-auth-lead-attribution",
  "version": "0.1.1",
  "description": "Better Auth 插件：访客线索归因（UTM/referrer/落地页）、行为事件追踪与支付转化记录",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "better-auth",
    "attribution",
    "analytics",
    "conversion-tracking"
  ],
  "author": "HorizonWing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HorizonWing/lead-attribution.git"
  },
  "bugs": {
    "url": "https://github.com/HorizonWing/lead-attribution/issues"
  },
  "homepage": "https://github.com/HorizonWing/lead-attribution#readme",
  "peerDependencies": {
    "better-auth": ">=1.6.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/node": "^22.10.0",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.41.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
